{
  "name": "setu-desktop-app",
  "version": "1.0.0",
  "main": "Electron/main.js",
  "description": "Setu ERP Desktop App",
  "author": "Abhijeet Borse",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.setu.erp",
    "productName": "Setu ERP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "Electron/**/*",
      "Setu_API/**/*",
      "Setu_ERP/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
